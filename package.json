{
  "name": "walldye",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "The walldye.com site: procedural SVG wallpapers recoloured from three seed colours.",
  "homepage": "https://walldye.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickolaj-jepsen/walldye.git"
  },
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:nix": "PLAYWRIGHT_BROWSERS_PATH=$(nix build --no-link --print-out-paths nixpkgs#playwright-driver.browsers) PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=true playwright test",
    "fonts": "uv run scripts/fonts/subset.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-wasm": "2.6.2",
    "astro": "^7.3.5",
    "fast-png": "^8.0.0",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "1.59.1",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
