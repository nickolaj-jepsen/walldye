{
  "name": "walldye-next",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Research port of walldye.com to Next.js: CSS-variable recolor, server components and use cache.",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "codegen": "tsx scripts/codegen.ts",
    "cards": "tsx scripts/cards.ts",
    "predev": "tsx scripts/codegen.ts --drafts",
    "dev": "next dev",
    "prebuild": "pnpm codegen && pnpm cards",
    "build": "opennextjs-cloudflare build && cp .next/server/app/_not-found.html .open-next/assets/404.html",
    "prebuild:export": "pnpm codegen && pnpm cards",
    "build:export": "NEXT_OUTPUT=export next build",
    "preview": "opennextjs-cloudflare preview",
    "preview:export": "wrangler dev --config wrangler.export.jsonc",
    "lint": "biome check",
    "test": "vitest run",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "spike": "tsx scripts/spike/run.ts",
    "spike:bulk": "tsx scripts/spike/bulk.ts"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "fast-png": "^8.0.0",
    "next": "16.4.1",
    "nuqs": "2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opennextjs/cloudflare": "1.20.11",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "pngjs": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vitest": "^5.0.4",
    "wrangler": "4.151.0",
    "yaml": "^2.9.1"
  }
}
