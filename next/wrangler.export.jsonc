// The static export target (`pnpm build:export`, then `pnpm preview:export`): out/ as the Worker's
// static assets, with no script. No routes or custom domain: not deployed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walldye-next-static",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false
}
