// The OpenNext target (`pnpm build`, then `pnpm preview`). No routes or custom domain: not deployed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walldye-next",
  "main": "worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "preview_urls": false
}
