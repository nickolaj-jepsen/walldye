---
import { getCollection } from 'astro:content';
import Chips from '../components/Chips.astro';
import Plate from '../components/Plate.astro';
import Base from '../layouts/Base.astro';
import { SITE_ASPECTS, aspectLabel, defaultSort, filterGroups, sortPieces } from '../lib/content';
import { facetLabel } from '../server/taxonomy';
import { DEFAULT_FAMILY, FAMILIES, presetColors } from '../lib/presets';
import { inlineScript } from '../server/inline-script';

const collection = await getCollection('wallpapers');
const sort = defaultSort(collection.map((e) => e.data));
const entries = sortPieces(collection, sort);
const groups = filterGroups(entries.map((e) => e.data), facetLabel);
const total = entries.length;
// The view orders need a recorded view to mean anything (none in local builds without stats/).
const viewed = collection.some((e) => e.data.views > 0);
const featured = sort === 'featured';
const shapeBoot = await inlineScript('shape', !import.meta.env.DEV);
---

<Base description="Wallpapers drawn with code, in colors you choose." nav="index" mainClass="index">
  <h1 class="vh">Index</h1>
  <details class="filter" open>
    <summary><span class="sc">Filter</span><span class="state"></span></summary>
    <form id="facets" class="facets" role="search" aria-label="Filter wallpapers" action="/" method="get">
      <div class="search">
        <label class="label sc" for="q">Search</label>
        <input id="q" name="q" type="search" placeholder="title, artist or description" autocomplete="off" />
      </div>
      <fieldset>
        <legend class="sc">Sort</legend>
        <div class="seg">
          {featured && <label><input type="radio" name="sort" value="featured" checked /><span>featured</span></label>}
          <label><input type="radio" name="sort" value="newest" checked={sort === 'newest'} /><span>newest</span></label>
          {viewed && <label><input type="radio" name="sort" value="popular" checked={sort === 'popular'} /><span>popular</span></label>}
          {viewed && <label><input type="radio" name="sort" value="views" /><span>most viewed</span></label>}
          <label><input type="radio" name="sort" value="title" /><span>title</span></label>
        </div>
      </fieldset>
      <fieldset>
        <legend class="sc">Shape</legend>
        <div class="seg">
          {SITE_ASPECTS.map((a) => <label><input type="radio" name="shape" value={aspectLabel(a)} checked={a === '16:9'} /><span><span class="mono">{a}</span></span></label>)}
        </div>
      </fieldset>
      {
        groups.map((g) => (
          <fieldset>
            <legend class="sc">{g.legend}</legend>
            {g.entries.map((e) => (
              <label class="entry"><input type="checkbox" name={g.facet} value={e.value} /><span class="term">{e.label}</span><span class="leader" /><span class="count">{e.count}</span></label>
            ))}
          </fieldset>
        ))
      }
    </form>
    <button type="button" class="textbtn show" id="show-results">Show {total} {total === 1 ? 'wallpaper' : 'wallpapers'}</button>
  </details>
  {/* Phones start with the filter closed; decided before first paint so the grid does not jump. */}
  <script is:inline>document.currentScript.previousElementSibling.open = matchMedia('(min-width: 60.0625rem)').matches;</script>
  <section class="plates" aria-label="Wallpapers">
    {/* SHAPE BOOT (src/client/index/shape-boot.ts): sets this section's data-shape before first paint. */}
    <script is:inline set:html={shapeBoot} />
    <div class="themes" role="group" aria-labelledby="themes-h">
      <h2 id="themes-h" class="sc">Colors</h2>
      {/* One button per family, showing its theme for the system scheme (site.css picks the set). */}
      {FAMILIES.map((f) => (f.light ? <button type="button" data-family={f.name} aria-pressed={f.name === DEFAULT_FAMILY ? 'true' : 'false'} aria-label={f.name} title={f.name}><Chips colors={presetColors(f.dark)} class="for-dark" /><Chips colors={presetColors(f.light)} class="for-light" /></button> : <button type="button" data-preset={f.dark} aria-pressed="false" aria-label={f.name} title={f.name}><Chips colors={presetColors(f.dark)} /></button>))}
      <button type="button" class="textbtn" popovertarget="picker">Your own</button>
    </div>
    <p class="results-line"><span id="result-count" class="lnum">{total} {total === 1 ? 'wallpaper' : 'wallpapers'}</span><button type="reset" form="facets" class="textbtn clear">clear</button></p>
    <p class="empty">Try fewer filters or a shorter search.</p>
    <ul class="grid">
      {entries.map((e) => <Plate piece={e.data} />)}
    </ul>
  </section>
  <script>
    import '../client/index/page.ts';
  </script>
</Base>
