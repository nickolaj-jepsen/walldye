---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Attribution from '../components/Attribution.astro';
import Controls from '../components/Controls.astro';
import DownloadSummary from '../components/DownloadSummary.astro';
import Footnotes from '../components/Footnotes.astro';
import Plate from '../components/Plate.astro';
import PlateBox from '../components/PlateBox.astro';
import SourceCode from '../components/SourceCode.astro';
import Base from '../layouts/Base.astro';
import { DEFAULT_FORMAT, DEFAULT_SIZE_INDEX, EXPORT_SIZES, FORMATS, captionSources, filterGroups, fitsAnyScreen, formatAdded, indexQuery, relatedPieces, type Piece } from '../lib/content';
import { LICENSE_LINES, TAKEDOWN_CONTACT, type TaxonomyFacet } from '../lib/labels';
import { TAXONOMY, facetLabel } from '../server/taxonomy';
import { DEFAULT_LICENSE, FAN_WORK } from '../server/meta';
import { inlineScript } from '../server/inline-script';

export async function getStaticPaths() {
  const entries = await getCollection('wallpapers');
  const groups = filterGroups(entries.map((e) => e.data), facetLabel);
  // Facts link to the index only for values it offers as filters.
  const filters = new Set(groups.flatMap((g) => g.entries.map((e) => `${g.facet}:${e.value}`)));
  const pieces = entries.map((e) => e.data);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    // Four fill a row of the grid at desktop widths.
    props: { entry, filters, related: relatedPieces(entry.data, pieces, 4) },
  }));
}

interface Props {
  entry: CollectionEntry<'wallpapers'>;
  filters: Set<string>;
  related: Piece[];
}

const { entry, filters, related } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);
const hasNotes = Boolean(entry.rendered?.html);

const facts = (facet: TaxonomyFacet) =>
  p[facet].map((v) => ({ label: facetLabel(facet, v)!, href: filters.has(`${facet}:${v}`) ? indexQuery(facet, v) : undefined }));
const technique = facts('technique');
const lineage = facts('lineage');
const aspectsText = p.aspects.join(', ');

// Figures inside names ("Opus 5.5") take lining numerals.
const credit = (p.model ? `Made with ${TAXONOMY.models[p.model]}` : `Made by ${p.author}`).split(/(\S*\d\S*)/).map((text, i) => ({ text, lnum: i % 2 === 1 }));
const fanWork = p.resolvedLicense === FAN_WORK ? p.franchise : undefined;
const licenseLine = p.resolvedLicense !== DEFAULT_LICENSE && p.resolvedLicense !== FAN_WORK ? LICENSE_LINES[p.resolvedLicense] : undefined;
// The export panel's first choices, which the client keeps in step.
const quickFormat = FORMATS.find((f) => f.value === DEFAULT_FORMAT)!.label;
const quickSize = EXPORT_SIZES['16:9'][DEFAULT_SIZE_INDEX].replace('x', '×');
const shapeBoot = await inlineScript('detailShape', !import.meta.env.DEV);
const panelBoot = await inlineScript('detailPanel', !import.meta.env.DEV);
---

<Base title={p.title} description={p.description} image={`/og/${p.slug}.jpg`} imageAlt={p.description} ogType="article" mainClass="detail">
  {/* The first render waits for the plate, which a plate carried from a grid lands on (src/client/transition/), and for the panel boot. */}
  <link slot="head" rel="expect" href="#panel-boot" blocking="render" />
  <figure class="spread">
    {/* SHAPE BOOT (src/client/detail/shape-boot.ts): sets this figure's data-aspect before first paint. */}
    <script is:inline set:html={shapeBoot} />
    <PlateBox piece={p}><div class="crop" data-axis="x" hidden><span class="handle"></span></div></PlateBox>
  </figure>

  <div class="below">
    <div class="label">
      <h1>{p.title}</h1>
      {captionSources(p) && <p class="attr"><Attribution piece={p} refs /></p>}
      <button type="button" class="download quick" id="quick-download"><span class="k">Download</span> <DownloadSummary format={quickFormat} size={quickSize} /></button>
      <p class="desc" id="desc">{p.description}</p>
      <p class="credit">{credit.map((c) => (c.lnum ? <span class="lnum">{c.text}</span> : c.text))}</p>
      {fanWork && <p class="license">Unofficial fan tribute, not affiliated with or endorsed by {fanWork.owner}. <i>{fanWork.title}</i> and its characters are trademarks of their owners. Non-commercial; contact <a href={`mailto:${TAKEDOWN_CONTACT}`}>{TAKEDOWN_CONTACT}</a> for takedown.</p>}
      {licenseLine && <p class="license">{licenseLine}</p>}
      <dl class="facts hair-t">
        {technique.length > 0 && <Fragment><dt>Technique</dt><dd>{technique.map((f, i) => <Fragment>{i > 0 && ', '}{f.href ? <a href={f.href}>{f.label}</a> : f.label}</Fragment>)}</dd></Fragment>}
        {lineage.length > 0 && <Fragment><dt>Inspired by</dt><dd>{lineage.map((f, i) => <Fragment>{i > 0 && ', '}{f.href ? <a href={f.href}>{f.label}</a> : f.label}</Fragment>)}</dd></Fragment>}
        <dt>Shape</dt><dd>{fitsAnyScreen(p) ? 'Any screen' : <Fragment><span class="mono">{aspectsText}</span> (cropped for other screens)</Fragment>}</dd>
        <dt>Added</dt><dd>{formatAdded(p.added)}</dd>
      </dl>
    </div>

    <Controls piece={p} />
    {/* PANEL BOOT (src/client/detail/panel-boot.ts): puts the export panel and both Download summaries in the start state before first paint. */}
    <script is:inline id="panel-boot" set:html={panelBoot} />

    {
      (hasNotes || p.sources.length > 0) && (
        <div class="label-more">
          {hasNotes && (
            <section class="sect" aria-labelledby="notes-h">
              <h2 id="notes-h" class="sc hair-t">Notes</h2>
              <div class="prose"><Content /></div>
            </section>
          )}
          {p.sources.length > 0 && (
            <section class="sect" aria-labelledby="sources-h">
              <h2 id="sources-h" class="sc hair-t">Sources</h2>
              <Footnotes piece={p} />
            </section>
          )}
        </div>
      )
    }
  </div>

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-h">
        <h2 id="related-h" class="sc hair-t">See also</h2>
        <ul class="grid">
          {related.map((r) => (
            <Plate piece={r} heading="h3" />
          ))}
        </ul>
      </section>
    )
  }

  <SourceCode piece={p} />
  <script>
    import '../client/detail/page.ts';
  </script>
</Base>

<style>
  /* One line per license notice under the credit, in the credit's type. */
  .license {
    font-size: var(--fs-2);
    color: var(--text-2);
  }
  /* A shape with its own template shows that template whole, centered in the 16:9 picture, inside a frame like the crop window's so the shape reads. The frame replaces the plate's; ::before stays the height spacer. */
  .spread :global(.plate img:not([data-aspect='16:9'])) {
    object-position: center;
  }
  .spread :global(.plate:has(> img:not([data-aspect='16:9']))::after) {
    --w: min(100cqw, 100cqw * 9 / 16 * var(--shape));
    --h: min(100cqw * 9 / 16, 100cqw / var(--shape));
    z-index: 1;
    left: calc((100cqw - var(--w)) / 2);
    top: calc((100cqw * 9 / 16 - var(--h)) / 2);
    width: var(--w);
    height: var(--h);
    box-shadow: inset 0 0 0 1px var(--text);
  }
  /* Phones in a tall shape: the plate takes that shape, showing the crop itself rather than 16:9 with the crop window, and a sideways drag moves the crop. */
  @media (max-width: 60rem) {
    /* Plate, title, attribution (up to two lines) and Download share the first screen: 25u of gaps and lines, plus 1u for the round-up. */
    .spread[data-tall] :global(.plate) {
      --ratio: var(--shape-ratio);
      width: min(100%, max(10rem, calc((100svh - var(--masthead-h) - 26 * var(--u)) * var(--ratio))));
      margin-inline: auto;
      touch-action: pan-y;
    }
    .spread[data-tall] :global(.plate > img[data-aspect='16:9']) {
      object-fit: cover;
      object-position: var(--pos, 50% 50%);
      cursor: ew-resize;
    }
    .spread[data-tall] :global(.plate > .crop) {
      display: none;
    }
    /* The shape's own template fills the plate, so the plate's own frame comes back. */
    .spread[data-tall] :global(.plate:has(> img:not([data-aspect='16:9']))::after) {
      left: 0;
      top: 0;
      width: auto;
      height: calc(100cqw / var(--ratio));
      box-shadow: inset 0 0 0 1px var(--plate-edge);
    }
  }
  /* Fullscreen (the f key): the wallpaper alone, centered on its ground. */
  .spread :global(.plate:fullscreen img) {
    height: 100%;
    object-position: center;
  }
  .spread :global(.plate:fullscreen .crop),
  .spread :global(.plate:fullscreen::before),
  .spread :global(.plate:fullscreen::after) {
    display: none;
  }
</style>
