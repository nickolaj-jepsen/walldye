---
/**
 * The detail page's controls column, rendered for the default version, fireproof,
 * 16:9 and the default size and format; the client keeps it in step.
 */
import { DEFAULT_PRESET } from './presets';
import { DEFAULT_FORMAT, DEFAULT_SIZE_INDEX, DEFAULT_VARIANT, EXPORT_SIZES, FORMATS, SITE_ASPECTS, downloadName, type Piece } from '../lib/content';
import { isText, knobStep, readout, type Knob } from '../lib/controls';

interface Props {
  piece: Piece;
}
const { piece: p } = Astro.props;
// Every version's params and whether a new draw changes it, the default included.
const drawn = p.versions.length ? p.versions : [{ name: DEFAULT_VARIANT, params: p.params, redraw: p.redraw }];
const drawing = p.drawable && (p.knobs.length > 0 || drawn.some((v) => v.redraw));
const drawingData = drawing
  ? JSON.stringify({
      versions: Object.fromEntries(drawn.map((v) => [v.name, { params: v.params, redraw: v.redraw }])),
      knobs: p.knobs,
      data: p.dataFiles.map((f) => ({ name: f.name, url: f.url })),
    })
  : undefined;
const knobs = p.knobs as Knob[];
const sections = [p.versions.length > 0 && 'Versions', drawing && 'drawing', 'colours', 'export'].filter(Boolean) as string[];
const label = `${sections.slice(0, -1).join(', ')} and ${sections.at(-1)}`.replace(/^\w/, (c) => c.toUpperCase());
const seeds = [
  { seed: 'bg', value: DEFAULT_PRESET.bg, role: 'background' },
  { seed: 'fg', value: DEFAULT_PRESET.fg, role: 'foreground' },
  { seed: 'accent', value: DEFAULT_PRESET.accent, role: 'accent' },
] as const;
const sizes = EXPORT_SIZES['16:9'];
const size = sizes[DEFAULT_SIZE_INDEX];
const format = FORMATS.find((f) => f.value === DEFAULT_FORMAT)!;
const file = downloadName(p.slug, DEFAULT_VARIANT, DEFAULT_PRESET.name, format, size, '16:9', false);
---

<section class="controls" aria-label={label}>
  {
    p.versions.length > 0 && (
      <section aria-labelledby="versions-h">
        <h2 id="versions-h" class="sc">Versions</h2>
        <div class="seg versions" id="versions" role="radiogroup" aria-labelledby="versions-h">
          {p.versions.map((v) => <label><input type="radio" name="v" value={v.name} checked={v.name === DEFAULT_VARIANT} /><span>{v.label}</span></label>)}
        </div>
      </section>
    )
  }
  {
    drawing && (
      <section id="drawing" aria-labelledby="drawing-h" data-drawing={drawingData}>
        <h2 id="drawing-h" class="sc">Drawing</h2>
        {knobs.map((k) => {
          const value = drawn[0].params[k.name];
          const id = `knob-${k.name}`;
          if (k.choices)
            return (
              <div class="row">
                <span class="k" id={`${id}-k`}>{k.label}</span>
                <div class="seg" role="radiogroup" aria-labelledby={`${id}-k`}>
                  {k.choices.map((c) => <label><input type="radio" name={id} data-knob={k.name} value={String(c.value)} checked={c.value === value} /><span>{c.label}</span></label>)}
                </div>
              </div>
            );
          if (k.kind === 'bool')
            return (
              <div class="row">
                <span class="k" />
                <label class="entry"><input type="checkbox" data-knob={k.name} checked={value === true} /><span class="term">{k.label}</span></label>
              </div>
            );
          if (isText(k))
            return (
              <div class="row">
                <label class="k" for={id}>{k.label}</label>
                <input class="textknob" id={id} type="text" data-knob={k.name} value={String(value)} maxlength={k.maxLen} spellcheck="false" autocomplete="off" autocapitalize="off" enterkeyhint="done" />
              </div>
            );
          return (
            <div class="row center">
              <label class="k" for={id}>{k.label}</label>
              <div class="knob">
                <input class="range" id={id} type="range" data-knob={k.name} min={k.lo} max={k.hi} step={knobStep(k)} value={String(value)} />
                {readout(k, value) !== null && <span class="mono readout" data-readout={k.name}>{readout(k, value)}</span>}
              </div>
            </div>
          );
        })}
        <p class="actions">
          <button type="button" class="textbtn" data-action="redraw" hidden={!drawn[0].redraw}>Draw another</button>
          <button type="button" class="textbtn" data-action="restore" hidden>Back to the original</button>
        </p>
        <p class="row" aria-live="polite"><span class="sub msg" id="draw-status"></span></p>
      </section>
    )
  }
  <section aria-labelledby="theme-h">
    <h2 id="theme-h" class="sc">Colours</h2>
    <ul class="seedlist">
      {seeds.map((s) => <li><span class="chip" style={`--c:var(--seed-${s.seed})`} /><span class="mono" data-seed={s.seed}>{s.value}</span><span class="role">{s.role}</span></li>)}
    </ul>
    <p class="actions"><button type="button" class="textbtn" popovertarget="picker">Change</button><button type="button" class="textbtn" data-action="copy-link">Copy link</button></p>
  </section>

  <section id="export" aria-labelledby="export-h" data-license={p.licence}>
    <h2 id="export-h" class="sc">Export</h2>
    <div class="row"><span class="k">Format</span><div class="seg" role="radiogroup" aria-label="Format">{FORMATS.map((f) => <label><input type="radio" name="fmt" value={f.value} data-ext={f.ext} checked={f === format} /><span>{f.label}</span></label>)}</div><span class="sub hint" id="format-hint" hidden>This browser can’t make WebP files.</span></div>
    <div class="row"><span class="k">Shape</span><div class="seg" role="radiogroup" aria-label="Shape">{SITE_ASPECTS.map((a) => <label><input type="radio" name="asp" value={a} data-native={p.aspects.includes(a) ? '' : undefined} checked={a === '16:9'} /><span><span class="mono">{a}</span></span></label>)}</div><span class="sub hint" id="shape-hint" hidden>cropped from <span class="mono">16:9</span></span></div>
    <div class="row center" id="crop-row" hidden><span class="k">Crop</span><input class="range" id="crop" type="range" min="0" max="1" step="0.001" value="0.5" aria-label="Crop position" /></div>
    <div class="row"><span class="k">Size</span><div class="seg" id="sizes" role="radiogroup" aria-label="Size">{sizes.map((s) => <label><input type="radio" name="size" value={s} checked={s === size} /><span><span class="mono">{s.replace('x', '×')}</span></span></label>)}<label><input type="radio" name="size" value="screen" /><span>your screen</span></label></div><span class="sub hint" id="size-limit" hidden>This browser can’t draw a file that large.</span><span class="sub hint lnum" id="cell-note" hidden></span></div>
    <button type="button" class="download row" id="download"><span class="k">Download</span><span class="file"><span class="mono" id="download-name">{file}</span></span></button>
    <p class="row" aria-live="polite"><span class="sub msg err" id="export-error"></span></p>
  </section>
</section>

<style>
  /* One version per line, like the index's facet entries. */
  .versions {
    flex-direction: column;
    align-items: start;
  }
  /* The knobs share one key column as wide as the longest label, never narrower than Export's, so a label stays on one line. */
  #drawing {
    display: grid;
    grid-template-columns: minmax(6.5rem, max-content) minmax(0, 1fr);
  }
  #drawing > * {
    grid-column: 1 / -1;
  }
  #drawing > .row {
    grid-template-columns: subgrid;
  }
  #drawing > .row > .k {
    white-space: nowrap;
    padding-right: calc(2 * var(--u));
  }
  @media (max-width: 60rem) {
    #drawing {
      grid-template-columns: minmax(6rem, max-content) minmax(0, 1fr);
    }
  }
  /* Text is typed on an underline, like the colour fields, in the mono face the pixel pieces draw it in. */
  .textknob {
    width: 100%;
    height: var(--l);
    padding: 0;
    border: 0;
    border-radius: 0;
    background: linear-gradient(var(--control), var(--control)) bottom / 100% 1px no-repeat;
    color: var(--text);
    font-family: var(--mono);
    font-size: var(--mono-em);
    font-variant-ligatures: none;
    line-height: var(--l);
    outline-offset: 3px;
  }
  .textknob[aria-invalid='true'] {
    background-image: linear-gradient(var(--link), var(--link));
    background-size: 100% 2px;
  }
  /* iOS zooms the page when a focused input is under 16px. */
  @media (pointer: coarse) {
    .textknob {
      font-size: 16px;
    }
  }
  @media (forced-colors: active) {
    .textknob {
      border-bottom: 1px solid CanvasText;
    }
  }
  /* A knob's slider with its value after it, the value's width fixed so the slider does not jump. */
  .knob {
    display: flex;
    align-items: center;
    gap: calc(2 * var(--u));
  }
  .knob .readout {
    flex: none;
    min-width: 5ch;
    text-align: right;
    color: var(--text);
  }
  /* A format or size the browser cannot make (the client disables it) fades to the guarded --text-dim. */
  .seg :global(input:disabled + span) {
    color: var(--text-dim);
    cursor: default;
  }
  .seg :global(label:has(input:disabled)) {
    cursor: default;
  }
</style>
