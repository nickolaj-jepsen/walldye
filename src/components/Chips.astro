---
/** Three swatches (bg, fg, accent) as `.chips`; decorative, so hidden from assistive tech. */
interface Props {
  /** CSS colors, e.g. `var(--seed-bg)` or `#1C1B1A`. */
  colors: readonly [string, string, string];
}
const { colors } = Astro.props;
---

<span class="chips" aria-hidden="true">{colors.map((c) => <span class="chip" style={`--c:${c}`} />)}</span>
