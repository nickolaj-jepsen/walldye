---
/** The theme popover opened by the header's theme button; behavior lives in the client. */
import Chips from './Chips.astro';
import { DEFAULT_FAMILY, DEFAULT_PRESET, FAMILIES, presetColors } from '../lib/presets';

const fields = [
  { seed: 'bg', label: 'Background', value: DEFAULT_PRESET.bg },
  { seed: 'fg', label: 'Foreground', value: DEFAULT_PRESET.fg },
  { seed: 'accent', label: 'Accent', value: DEFAULT_PRESET.accent },
] as const;
---

<div id="picker" class="picker" popover role="dialog" aria-labelledby="picker-h">
  <h2 id="picker-h" class="vh">Theme</h2>
  <div class="group">
    <h3 class="sc">Themes</h3>
    {/* A family's name follows the system scheme; its swatches fix one of its two themes. */}
    <ul class="presets">
      {
        FAMILIES.map((f) => (
          <li>
            {f.light ? (
              <>
                <button type="button" class="family" data-family={f.name} aria-pressed={f.name === DEFAULT_FAMILY ? 'true' : 'false'}><span class="name">{f.name}</span><span class="leader" /></button>
                {[f.dark, f.light].map((name) => (
                  <button type="button" class="swatch" data-preset={name} aria-pressed="false" aria-label={name} title={name}><Chips colors={presetColors(name)} /></button>
                ))}
              </>
            ) : (
              <button type="button" class="single" data-preset={f.dark} aria-pressed="false"><span class="entryname"><span class="name">{f.name}</span><span class="leader" /></span><Chips colors={presetColors(f.dark)} /></button>
            )}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="group hair-t">
    <h3 class="sc">Colors</h3>
    {
      fields.map((f) => (
        <div class="hexfield"><label class="k" for={`seed-${f.seed}`}>{f.label}</label><span class="chip" style={`--c:var(--seed-${f.seed})`}><input type="color" value={f.value.toLowerCase()} aria-label={`Pick ${f.label.toLowerCase()} color`} /></span><input id={`seed-${f.seed}`} data-seed={f.seed} value={f.value} spellcheck="false" autocomplete="off" autocapitalize="characters" /></div>
      ))
    }
    <label class="importfield"><span class="k">Import</span><input id="theme-import" placeholder="paste a terminal theme" spellcheck="false" autocomplete="off" aria-describedby="import-msg" /></label>
    <div class="msgs" aria-live="polite">
      <p id="seed-msg" class="msg err" hidden>Use a hex color, like <span class="mono">#CF6A4C</span>.</p>
      <p id="faint-msg" class="msg warn" hidden>The background and foreground are too close, so wallpapers will be hard to see.</p>
      <p id="accent-bg-msg" class="msg warn" hidden>The accent is too close to the background, so it will barely show in wallpapers.</p>
      <p id="accent-fg-msg" class="msg warn" hidden>The accent is too close to the foreground, so it will barely stand out in wallpapers.</p>
      <p id="import-msg" class="msg err" hidden>No colors found in that text.</p>
    </div>
  </div>
  <p class="actions"><button type="button" class="textbtn" data-action="copy-link">Copy link</button></p>
</div>
