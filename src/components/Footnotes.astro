---
/**
 * The Sources list. A caption-cited source's link back never wraps away from the
 * entry's last word.
 */
import { captionSources, type Piece } from '../lib/content';

interface Props {
  piece: Piece;
}
const { piece: p } = Astro.props;
const cited = new Set(captionSources(p)?.items.map((c) => c.n) ?? []);
const notes = p.sources.map((s, i) => ({
  n: i + 1,
  author: s.author,
  name: s.title ?? s.topic,
  work: s.title !== undefined,
  lang: s.lang,
  url: s.url,
  year: s.year === undefined ? '' : `${s.author || s.title || s.topic ? ', ' : ''}${s.year}`,
  sep: s.author && (s.title || s.topic) ? ', ' : '',
}));
---

<ol class="footnotes">
  {
    notes.map((f) => (
      <li id={`fn${f.n}`}><span>{f.url && !f.name ? <a href={f.url}>{f.author}</a> : f.author}{f.sep}{f.name && (f.url ? <a href={f.url}>{f.work ? <i lang={f.lang}>{f.name}</i> : <span lang={f.lang}>{f.name}</span>}</a> : f.work ? <i lang={f.lang}>{f.name}</i> : <span lang={f.lang}>{f.name}</span>)}{f.year}{cited.has(f.n) ? <span class="nowrap">.{' '}<a href={`#fnref${f.n}`} class="back" aria-label="Back to text">↑</a></span> : '.'}</span></li>
    ))
  }
</ol>

<style>
  /* Source links read like the other in-text links (site.css .prose a). */
  a:not(.back) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--link-line);
  }
  a:not(.back):hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }
</style>
