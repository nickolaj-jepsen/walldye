---
/**
 * What a Download button makes: the format, the size (or an SVG's shape) and, for the visitor's own
 * screen size, "for your screen", which site.css shows. The detail page's client keeps every copy's
 * text in step.
 */
interface Props {
  format: string;
  size: string;
}
const { format, size } = Astro.props;
---

<span class="file"><span data-part="format">{format}</span>, <span class="mono" data-part="size">{size}</span><span data-part="yours"> for your screen</span></span>
