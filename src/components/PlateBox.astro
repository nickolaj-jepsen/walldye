---
/**
 * A `.plate`: the wallpaper box the client fills with a recoloured `<img>`,
 * carrying the default version's template and slots URLs, and on the detail spread every version's.
 * Before JS it is an empty box of the grid's shape (16:9 unless site.css says otherwise) on the plate ground; without JS a `<noscript>` shows the
 * untouched 16:9 template. Children (the crop window) go after it.
 */
import type { Piece } from '../lib/content';

interface Props {
  piece: Piece;
  /** Only the 16:9 templates of the default version (grid plates, which read other shapes' URLs from slots.json); otherwise every aspect and version (detail spread). */
  only169?: boolean;
  /** Lazy-load the no-JS image. */
  lazy?: boolean;
}
const { piece: p, only169 = false, lazy = false } = Astro.props;
const urls = (templates: Piece['templates']) =>
  Object.fromEntries(
    Object.entries(templates)
      .filter(([key]) => !only169 || key.startsWith('16:9/'))
      .map(([key, t]) => [key, t.url]),
  );
const variants =
  only169 || !p.versions.length
    ? undefined
    : JSON.stringify(Object.fromEntries(p.versions.map((v) => [v.name, { templates: urls(v.templates), slots: v.slotsUrl, alt: v.description }])));
---

<div class="plate" data-plate={p.slug} data-templates={JSON.stringify(urls(p.templates))} data-slots={p.slotsUrl} data-alt={p.description} data-variants={variants}><noscript><img src={p.templates['16:9/dark'].url} alt={p.description} width="1920" height="1080" loading={lazy ? 'lazy' : undefined} decoding="async" /></noscript><slot /></div>

<style>
  /* site.css sizes an `:empty` plate; one holding only its <noscript> (or the crop window) is still waiting for its image. */
  .plate:not(:has(img)) {
    aspect-ratio: var(--ratio);
  }
  /* Same rounded-up height as the image will take (site.css .plate img), so captions do not move when it arrives. */
  @supports (height: round(up, 1px, 1px)) {
    .plate:not(:has(img)) {
      aspect-ratio: auto;
    }
    .plate:not(:has(img))::before {
      content: '';
      display: block;
      height: round(up, calc(100cqw / var(--ratio)), var(--u));
    }
  }
</style>
