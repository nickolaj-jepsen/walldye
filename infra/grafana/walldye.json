  "description": "walldye.com product events: the last three months from Analytics Engine, the history from the stats branch.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Last three months (Analytics Engine)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Visitors per day",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_ANALYTICS_ENGINE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_ANALYTICS_ENGINE}"
          },
          "query": "SELECT $timeSeries AS t, count(DISTINCT visitor) AS visitors FROM (SELECT timestamp, blob6 AS visitor FROM walldye_events WHERE $timeFilter) GROUP BY t ORDER BY t",
          "editorMode": "sql",
          "format": "time_series",
          "database": "",
          "table": "walldye_events",
          "dateColDataType": "",
          "dateTimeColDataType": "timestamp",
          "dateTimeType": "DATETIME",
          "round": "0s",
          "intervalFactor": 1,
          "extrapolate": false,
          "skip_comments": true,
          "add_metadata": false
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "description": "Distinct daily visitor keys that sent any event.",
      "interval": "1d"
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Exports per day by format",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_ANALYTICS_ENGINE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_ANALYTICS_ENGINE}"
          },
          "query": "SELECT $timeSeries AS t, blob10 AS format, SUM(_sample_interval) AS exports FROM walldye_events WHERE $timeFilter AND index1 = 'export' GROUP BY t, format ORDER BY t",
          "editorMode": "sql",
          "format": "time_series",
          "database": "",
          "table": "walldye_events",
          "dateColDataType": "",
          "dateTimeColDataType": "timestamp",
          "dateTimeType": "DATETIME",
          "round": "0s",
          "intervalFactor": 1,
          "extrapolate": false,
