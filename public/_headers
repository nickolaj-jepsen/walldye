# Response headers for the static assets of the walldye Worker.
# Rules that match one request add up and repeat headers are comma-joined, so no two
# Cache-Control rules below may match the same path.

# Content-addressed: templates, slots and catalog (/t/<sha256[:12]>.*), and Vite's hashed assets and fonts.
/t/*
  Cache-Control: public, max-age=31536000, immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is one path segment (build.format 'file'): /, /about, /404, /<slug>.
/
  Cache-Control: public, max-age=0, must-revalidate
/:page
  Cache-Control: public, max-age=0, must-revalidate

# Preview and version URLs on workers.dev; only walldye.com gets indexed.
https://:host.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
