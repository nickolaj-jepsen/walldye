# Response headers for the static assets of the walldye Worker.
# Rules that match one request add up and repeat headers are comma-joined, so no two
# Cache-Control rules below may match the same path.

# File names carry a content hash, so a path never changes content.
/t/*
  Cache-Control: public, max-age=31536000, immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is one path segment (build.format 'file').
/
  Cache-Control: public, max-age=0, must-revalidate
/:page
  Cache-Control: public, max-age=0, must-revalidate

# Version URLs on workers.dev; only walldye.com gets indexed.
https://:host.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
